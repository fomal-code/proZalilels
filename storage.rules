rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Same admin test as Firestore: /admins/{uid} must exist.
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Product images are public to read (the storefront shows them); only admins may write or delete.
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|avif|gif)');
      allow delete: if isAdmin();
    }
  }
}
