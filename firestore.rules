rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // An administrator is a signed-in user who has a document at /admins/{their uid}.
    // That collection can only be edited in the Firebase console (clients cannot write it).
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function listOk(v, max) {
      return v is list && v.size() <= max;
    }

    function validProduct(d) {
      return d.keys().hasAll(['name', 'price', 'images', 'published'])
        && d.keys().hasOnly(['name', 'price', 'compareAt', 'images', 'description', 'category',
                             'sizes', 'colours', 'stock', 'published', 'sortOrder',
                             'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.price is number && d.price >= 0
        && (!('compareAt' in d) || d.compareAt == null || (d.compareAt is number && d.compareAt >= 0))
        && listOk(d.images, 12)
        && d.published is bool
        && (!('description' in d) || (d.description is string && d.description.size() <= 5000))
        && (!('category' in d) || (d.category is string && d.category.size() <= 100))
        && (!('sizes' in d) || listOk(d.sizes, 40))
        && (!('colours' in d) || listOk(d.colours, 40))
        && (!('stock' in d) || d.stock == null || d.stock is number || d.stock is map)
        && (!('sortOrder' in d) || d.sortOrder is number);
    }

    // Public: published products only. Admins: everything.
    match /products/{productId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create: if isAdmin()
        && productId.matches('[A-Za-z0-9_-]{1,100}')
        && validProduct(request.resource.data);
      allow update: if isAdmin() && validProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    // Lets a signed-in user check ONLY their own admin record. Nobody can write or list it from a client.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Migration log etc. (admin only)
    match /meta/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
